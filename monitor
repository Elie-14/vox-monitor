"""Alert dispatcher: per-channel retries, persistent de-duplication, dry-run."""
import logging
import time
from zoneinfo import ZoneInfo

from . import email_alerts, push_alerts, whatsapp_alerts
from .database import Database, utcnow
from .detection import Alert

log = logging.getLogger(__name__)
CAIRO = ZoneInfo("Africa/Cairo")


def cairo_now_str() -> str:
    return utcnow().astimezone(CAIRO).strftime("%A %d %B %Y, %H:%M:%S (Africa/Cairo, UTC%z)")


def channel_registry(cfg: dict):
    """(name, configured?, sender(alert)->None). WhatsApp only if enabled in config."""
    n = cfg.get("notifications", {})
    prio = lambda a: 5 if a.kind in ("critical", "test") else (4 if a.kind == "preliminary" else 3)
    chans = [
        ("email", n.get("email", True) and email_alerts.configured(),
         lambda a: email_alerts.send(a.title, format_email(a))),
        ("ntfy", n.get("ntfy", True) and push_alerts.ntfy_configured(),
         lambda a: push_alerts.send_ntfy(a.title, short_body(a), a.url, prio(a))),
        ("telegram", n.get("telegram", False) and push_alerts.telegram_configured(),
         lambda a: push_alerts.send_telegram(a.title, short_body(a), a.url)),
        ("whatsapp", n.get("whatsapp", False) and whatsapp_alerts.configured(),
         lambda a: whatsapp_alerts.send(a.title, short_body(a), a.url)),
    ]
    return chans


def short_body(a: Alert) -> str:
    return f"{a.body}\n{cairo_now_str()}"


def format_email(a: Alert) -> str:
    status = {"critical": "CONFIRMED", "preliminary": "PRELIMINARY (not yet confirmed)"}.get(a.kind, a.kind.upper())
    return (f"{a.title}\n\nStatus: {status}\nTime: {cairo_now_str()}\n\nWhy the monitor thinks so:\n{a.body}\n\n"
            f"Booking link (official VOX Egypt):\n{a.url or 'https://egy.voxcinemas.com/movies/whatson'}\n\n"
            "The monitor never buys tickets or logs in for you - open the link and book yourself.\n")


def dispatch(db: Database, alert: Alert, cfg: dict, dry_run: bool = False, sleep=time.sleep) -> dict[str, str]:
    """Send to every configured channel that has not already delivered this alert. Returns {channel: result}."""
    results: dict[str, str] = {}
    max_attempts = cfg.get("notifications", {}).get("max_attempts_per_channel", 10)
    for name, ok_to_use, sender in channel_registry(cfg):
        if not ok_to_use:
            results[name] = "not-configured"
            continue
        st = db.notification_status(alert.key, name)
        if st and st["status"] == "sent":
            results[name] = "already-sent"
            continue
        if st and st["attempts"] >= max_attempts:
            results[name] = "gave-up"
            continue
        if dry_run:
            log.info("[dry-run] would send %s alert '%s' via %s", alert.kind, alert.title, name)
            results[name] = "dry-run"
            continue
        last_err = None
        for attempt in range(3):
            try:
                sender(alert)
                db.record_notification(alert.key, name, True)
                results[name] = "sent"
                log.info("alert %s sent via %s", alert.key, name)
                break
            except Exception as exc:  # noqa: BLE001 - never let one channel block the others
                last_err = f"{type(exc).__name__}: {str(exc)[:150]}"
                sleep(min(2 ** attempt, 4))
        else:
            db.record_notification(alert.key, name, False, last_err)
            results[name] = f"failed ({last_err})"
            log.error("alert %s failed via %s: %s", alert.key, name, last_err)
    return results

"""Free push channels: ntfy.sh (phone app + Windows companion) and Telegram."""
import os

import requests


def ntfy_configured() -> bool:
    return bool(os.environ.get("NTFY_TOPIC"))


def send_ntfy(title: str, message: str, url: str | None, priority: int) -> None:
    server = os.environ.get("NTFY_SERVER", "https://ntfy.sh").rstrip("/")
    payload = {"topic": os.environ["NTFY_TOPIC"], "title": title, "message": message,
               "priority": priority, "tags": ["rotating_light" if priority >= 5 else "movie_camera"]}
    if url:
        payload["click"] = url
        payload["actions"] = [{"action": "view", "label": "Open booking", "url": url}]
    r = requests.post(server, json=payload, timeout=20)
    r.raise_for_status()


def telegram_configured() -> bool:
    return bool(os.environ.get("TELEGRAM_BOT_TOKEN") and os.environ.get("TELEGRAM_CHAT_ID"))


def send_telegram(title: str, message: str, url: str | None) -> None:
    token, chat = os.environ["TELEGRAM_BOT_TOKEN"], os.environ["TELEGRAM_CHAT_ID"]
    text = f"{title}\n\n{message}" + (f"\n\n{url}" if url else "")
    r = requests.post(f"https://api.telegram.org/bot{token}/sendMessage", json={"chat_id": chat, "text": text}, timeout=20)
    r.raise_for_status()

"""Adaptive polling interval."""
import random

from .detection import ANNOUNCED, CONFIRMED_OPEN, SUSPECTED_OPEN


def choose_mode(cfg: dict, state: str, social: str | None) -> tuple[str, int]:
    s = cfg["schedule"]
    if state == CONFIRMED_OPEN:
        return "post_confirmation", s["post_confirmation_seconds"]
    if state == SUSPECTED_OPEN or social == "OPEN_NOW":
        return "high", s["high_seconds"]
    if state == ANNOUNCED or social == "FUTURE":
        return "elevated", s["elevated_seconds"]
    return "normal", s["normal_seconds"]


def next_interval(cfg: dict, state: str, social: str | None, rng: random.Random | None = None) -> tuple[str, float]:
    """Interval with +-10% jitter, never below the configured floor (site-friendly safety limit)."""
    rng = rng or random
    mode, secs = choose_mode(cfg, state, social)
    secs = max(secs, cfg["schedule"]["min_seconds"])
    return mode, secs * rng.uniform(0.9, 1.1)

"""Social / announcement sources.

Only legitimately automatable sources are polled (RSS/Atom feeds). Platforms whose public pages sit behind logins
or paid/approved APIs (Facebook, Instagram, TikTok) are registered as 'manual' and are NEVER scraped.
"""
import hashlib
import logging
import xml.etree.ElementTree as ET
from dataclasses import dataclass
from datetime import datetime, timedelta, timezone
from email.utils import parsedate_to_datetime

from .database import Database, iso, utcnow
from .detection import classify_text, normalize
from .http_client import PoliteClient

log = logging.getLogger(__name__)
ATOM = "{http://www.w3.org/2005/Atom}"


@dataclass
class Post:
    post_id: str
    url: str
    published_utc: str | None
    text: str


def _txt(el, *names) -> str:
    for n in names:
        found = el.find(n)
        if found is not None and (found.text or "").strip():
            return found.text.strip()
    return ""


def parse_feed(xml_text: str) -> list[Post]:
    try:
        root = ET.fromstring(xml_text)
    except ET.ParseError as exc:
        raise ValueError(f"feed is not valid XML: {exc}") from exc
    posts: list[Post] = []
    for it in root.iter("item"):  # RSS 2.0
        title, desc = _txt(it, "title"), _txt(it, "description")
        link, guid, pub = _txt(it, "link"), _txt(it, "guid"), _txt(it, "pubDate")
        published = None
        if pub:
            try:
                published = iso(parsedate_to_datetime(pub).astimezone(timezone.utc))
            except (TypeError, ValueError):
                pass
        posts.append(Post(guid or link or title, link, published, f"{title}\n{desc}".strip()))
    for en in root.iter(f"{ATOM}entry"):  # Atom (YouTube etc.)
        link_el = en.find(f"{ATOM}link")
        link = link_el.get("href", "") if link_el is not None else ""
        pid = _txt(en, f"{ATOM}id") or link
        pub = _txt(en, f"{ATOM}published", f"{ATOM}updated")
        summary = _txt(en, f"{ATOM}summary", f"{ATOM}content")
        media = en.find("{http://search.yahoo.com/mrss/}group")
        if media is not None:
            summary = summary or _txt(media, "{http://search.yahoo.com/mrss/}description")
        published = pub.replace("+00:00", "Z")[:19] + "Z" if pub else None
        posts.append(Post(pid, link, published, f"{_txt(en, f'{ATOM}title')}\n{summary}".strip()))
    return posts


def registry(cfg: dict) -> list[dict]:
    return cfg.get("sources", [])


def poll_source(src: dict, client: PoliteClient, db: Database, now: datetime | None = None) -> list[dict]:
    """Fetch a feed source; returns list of NEW/EDITED relevant posts [{post, verdict, trusted, change}]."""
    now = now or utcnow()
    name = src["id"]
    if src.get("method") != "rss" or not src.get("enabled", False) or not src.get("feed_url"):
        return []
    last = db.get_source(name).get("last_attempt_utc")
    interval = src.get("interval_seconds", 600)
    if last and (now - datetime.strptime(last, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)).total_seconds() < interval * 0.9:
        return []
    res = client.get(name, src["feed_url"], conditional=True)
    if not res.ok or res.not_modified:
        return []
    try:
        posts = parse_feed(res.text)
    except ValueError as exc:
        db.record_check(name, False, str(exc))
        return []
    relevant = []
    for p in posts:
        verdict = classify_text(p.text)
        h = hashlib.sha256(normalize(p.text).encode()).hexdigest()
        change = db.upsert_post(name, p.post_id, p.url, p.published_utc, p.text[:2000], h, verdict.kind, now)
        if change == "same" or verdict.kind in ("NONE", "MENTION"):
            continue
        repost = db.text_hash_seen_elsewhere(h, name, p.post_id)
        relevant.append({"post": p, "verdict": verdict, "trusted": bool(src.get("trusted", False)),
                         "change": change, "repost": repost, "source": name})
    return relevant


def current_social_signal(db: Database, cfg: dict, now: datetime | None = None) -> tuple[str | None, str | None, str | None]:
    """Most relevant trusted-source signal in the last N hours -> (signal, url, source)."""
    now = now or utcnow()
    hours = cfg.get("social_signal_window_hours", 48)
    trusted = {s["id"] for s in registry(cfg) if s.get("trusted")}
    posts = db.recent_posts(now - timedelta(hours=hours), ("OPEN_NOW", "FUTURE"), trusted)
    for kind in ("OPEN_NOW", "FUTURE"):
        for p in posts:
            if p["classification"] == kind:
                return kind, p["url"], p["source"]
    return None, None, None

"""VOX Cinemas Egypt booking-site monitor.

Verified (18 Oct 2026) by reading the public pages:
  * Movies that can be booked appear on  /movies/whatson  as a card with a "Showtimes" link
    (/movies/<slug>#showtimes) AND in the "Select Your Movie(s)" selector.
  * Movies that are not bookable yet (e.g. Avengers: Doomsday, release 16 Dec 2026) appear only on /movies/comingsoon.
  * A movie page's <title> already says "Now Showing | Book Tickets" even when it is only Coming Soon -> the title
    is NOT used as evidence.
NOT verified: the exact HTML of the per-cinema session list (no tickets are on sale for the target yet).
"""
import logging
import re
from dataclasses import dataclass, field

from bs4 import BeautifulSoup

from .detection import Evidence, mentions_target, normalize
from .http_client import PoliteClient

log = logging.getLogger(__name__)
_SLUG = re.compile(r"/movies/([a-z0-9][a-z0-9\-]*)(?:[/?#]|$)", re.I)
_NOT_MOVIE = {"whatson", "comingsoon"}


@dataclass
class Listing:
    cards: dict = field(default_factory=dict)        # slug -> {"title":..., "showtimes": bool}
    selector_movies: list = field(default_factory=list)
    cinemas: list = field(default_factory=list)


def _slug_of(href: str) -> str | None:
    m = _SLUG.search(href or "")
    if not m or m.group(1).lower() in _NOT_MOVIE:
        return None
    return m.group(1).lower()


def _between(text: str, start: str, ends: tuple[str, ...]) -> list[str]:
    i = text.find(start)
    if i < 0:
        return []
    seg = text[i + len(start):]
    cut = len(seg)
    for e in ends:
        j = seg.find(e)
        if j >= 0:
            cut = min(cut, j)
    lines = [re.sub(r"^\[[ x]?\]\s*", "", ln.strip()) for ln in seg[:cut].splitlines()]
    return [ln for ln in lines if ln and ln.lower() not in ("any movie", "clear all", "done", "close")]


def parse_listing(html: str) -> Listing:
    soup = BeautifulSoup(html, "html.parser")
    out = Listing()
    for a in soup.find_all("a", href=True):
        slug = _slug_of(a["href"])
        if not slug:
            continue
        entry = out.cards.setdefault(slug, {"title": "", "showtimes": False})
        txt = a.get_text(" ", strip=True)
        if txt.lower() == "showtimes" or a["href"].lower().endswith("#showtimes"):
            entry["showtimes"] = True
        elif txt and not entry["title"] and a.find_parent(["h2", "h3", "h4"]):
            entry["title"] = re.sub(r"^(?:G|PG|12\+|15\+|16\+|18\+|18TC|PG15)\s+", "", txt)
    page_text = soup.get_text("\n")
    out.selector_movies = _between(page_text, "Select Your Movie(s)", ("Find Times and Book", "Clear All\nDone\nFind"))
    # selector block ends at the first "Find Times and Book"; strip trailing control words
    out.cinemas = _between(page_text, "Select Your Cinema(s)", ("Clear All", "Select Your Movie(s)"))
    return out


def target_slugs_in(listing: Listing, cfg: dict, require_showtimes: bool) -> list[str]:
    wanted = {s.lower() for s in cfg.get("target_slugs", [])}
    hits = []
    for slug, e in listing.cards.items():
        if slug in wanted or mentions_target(e["title"]):
            if (e["showtimes"] or not require_showtimes):
                hits.append(slug)
    return hits


def target_in_selector(listing: Listing, cfg: dict) -> bool:
    return any(mentions_target(t) for t in listing.selector_movies)


def verify_movie_page(html: str) -> bool:
    soup = BeautifulSoup(html, "html.parser")
    h1 = soup.find("h1")
    og = soup.find("meta", attrs={"property": "og:title"})
    heading = (h1.get_text(" ", strip=True) if h1 else "") + " " + (og.get("content", "") if og else "")
    return mentions_target(heading)


def check_booking(client: PoliteClient, cfg: dict, check_coming_soon: bool = True) -> tuple[Evidence, dict]:
    """Returns (evidence, extras). extras['cinemas'] lists the branches the site currently shows."""
    base = cfg["base_url"].rstrip("/")
    extras: dict = {}
    res = client.get("vox_whatson", f"{base}/movies/whatson", conditional=False)
    if not res.ok:
        return Evidence(False, error=res.error or "vox_whatson failed"), extras
    listing = parse_listing(res.text)
    if not listing.cards:  # page loaded but looks wrong -> inconclusive, NOT evidence of anything
        client.db.record_check("vox_whatson", False, "page parsed but no movie cards found (layout changed?)")
        return Evidence(False, error="what's-on page had no movie cards (layout changed?)"), extras
    extras["cinemas"] = listing.cinemas

    open_slugs = target_slugs_in(listing, cfg, require_showtimes=True)
    in_selector = target_in_selector(listing, cfg)
    in_cs = False
    if check_coming_soon:
        cs = client.get("vox_comingsoon", f"{base}/movies/comingsoon", conditional=False)
        if cs.ok:
            cs_listing = parse_listing(cs.text)
            in_cs = bool(target_slugs_in(cs_listing, cfg, require_showtimes=False))
    elif (client.db.get_kv("last_in_coming_soon") or False):
        in_cs = True
    if check_coming_soon:
        client.db.set_kv("last_in_coming_soon", in_cs)

    page_verified, booking_url = False, None
    candidates = open_slugs or ([s for s in cfg.get("target_slugs", [])] if in_selector else [])
    for slug in candidates:
        url = f"{base}/movies/{slug}"
        pg = client.get(f"vox_movie_{slug}", url, conditional=False)
        if pg.ok and verify_movie_page(pg.text):
            page_verified, booking_url = True, url + "#showtimes"
            break
    if open_slugs and not booking_url:
        booking_url = f"{base}/movies/{open_slugs[0]}#showtimes"
    return Evidence(True, on_whatson=bool(open_slugs), in_selector=in_selector, in_coming_soon=in_cs,
                    page_verified=page_verified, booking_url=booking_url), extras

"""WhatsApp Business Cloud API (official). DISABLED by default.

Cost note (verified 18 Oct 2026): since 1 Oct 2026 Meta charges per delivered message even inside the 24-hour
customer-service window, and messaging you first needs an approved template. It needs a Meta Business account,
a phone number registered to the API (not your personal WhatsApp number) and a template. Enable only with approval.
"""
import os

import requests

GRAPH = "https://graph.facebook.com/v21.0"


def configured() -> bool:
    return all(os.environ.get(k) for k in ("WHATSAPP_TOKEN", "WHATSAPP_PHONE_NUMBER_ID", "WHATSAPP_TO"))


def send(title: str, message: str, url: str | None) -> None:
    token, phone_id, to = os.environ["WHATSAPP_TOKEN"], os.environ["WHATSAPP_PHONE_NUMBER_ID"], os.environ["WHATSAPP_TO"]
    template = os.environ.get("WHATSAPP_TEMPLATE")
    if template:  # approved template with one body parameter
        body = {"messaging_product": "whatsapp", "to": to, "type": "template",
                "template": {"name": template, "language": {"code": "en"},
                             "components": [{"type": "body", "parameters": [{"type": "text", "text": f"{title} {url or ''}"[:900]}]}]}}
    else:  # free-form text only works inside an open 24h customer-service window
        body = {"messaging_product": "whatsapp", "to": to, "type": "text", "text": {"body": f"{title}\n{message}\n{url or ''}"}}
    r = requests.post(f"{GRAPH}/{phone_id}/messages", json=body, headers={"Authorization": f"Bearer {token}"}, timeout=20)
    r.raise_for_status()


"""SQLite persistence: state, source health, posts, notification history, lock."""
import json
import sqlite3
import threading
from datetime import datetime, timedelta, timezone

SCHEMA = """
CREATE TABLE IF NOT EXISTS kv (key TEXT PRIMARY KEY, value TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS source_status (
  source TEXT PRIMARY KEY, last_ok_utc TEXT, last_attempt_utc TEXT,
  consecutive_failures INTEGER NOT NULL DEFAULT 0, total_failures INTEGER NOT NULL DEFAULT 0,
  total_checks INTEGER NOT NULL DEFAULT 0, last_error TEXT,
  etag TEXT, last_modified TEXT, content_hash TEXT, next_allowed_utc TEXT);
CREATE TABLE IF NOT EXISTS posts (
  source TEXT NOT NULL, post_id TEXT NOT NULL, url TEXT, published_utc TEXT,
  first_seen_utc TEXT NOT NULL, text TEXT, text_hash TEXT, classification TEXT,
  PRIMARY KEY (source, post_id));
CREATE TABLE IF NOT EXISTS notifications (
  alert_key TEXT NOT NULL, channel TEXT NOT NULL, status TEXT NOT NULL,
  attempts INTEGER NOT NULL DEFAULT 0, last_error TEXT, created_utc TEXT NOT NULL, sent_utc TEXT,
  PRIMARY KEY (alert_key, channel));
CREATE TABLE IF NOT EXISTS events (id INTEGER PRIMARY KEY AUTOINCREMENT, ts_utc TEXT NOT NULL, kind TEXT NOT NULL, detail TEXT);
"""


def utcnow() -> datetime:
    return datetime.now(timezone.utc)


def iso(dt: datetime) -> str:
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_iso(s: str | None) -> datetime | None:
    if not s:
        return None
    return datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)


class Database:
    def __init__(self, path: str):
        self.path = path
        self._lock = threading.RLock()
        self.conn = sqlite3.connect(path, timeout=30, isolation_level=None, check_same_thread=False)
        self.conn.row_factory = sqlite3.Row
        self.conn.executescript(SCHEMA)

    def close(self) -> None:
        self.conn.close()

    # ---- key/value -------------------------------------------------
    def get_kv(self, key: str, default=None):
        with self._lock:
            row = self.conn.execute("SELECT value FROM kv WHERE key=?", (key,)).fetchone()
        return json.loads(row["value"]) if row else default

    def set_kv(self, key: str, value) -> None:
        with self._lock:
            self.conn.execute("INSERT INTO kv(key,value) VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value",
                              (key, json.dumps(value, ensure_ascii=False)))

    def log_event(self, kind: str, detail: str = "", now: datetime | None = None) -> None:
        with self._lock:
            self.conn.execute("INSERT INTO events(ts_utc,kind,detail) VALUES(?,?,?)", (iso(now or utcnow()), kind, detail[:500]))
            self.conn.execute("DELETE FROM events WHERE id < (SELECT MAX(id)-2000 FROM events)")

    # ---- lock (protects against duplicate concurrent workers) ------
    def try_lock(self, owner: str, ttl_seconds: int = 600, now: datetime | None = None) -> bool:
        now = now or utcnow()
        with self._lock:
            self.conn.execute("BEGIN IMMEDIATE")
            try:
                cur = self.get_kv("worker_lock")
                if cur and cur["owner"] != owner and parse_iso(cur["expires"]) > now:
                    self.conn.execute("ROLLBACK")
                    return False
                self.set_kv("worker_lock", {"owner": owner, "expires": iso(now + timedelta(seconds=ttl_seconds))})
                self.conn.execute("COMMIT")
                return True
            except Exception:
                self.conn.execute("ROLLBACK")
                raise

    def release_lock(self, owner: str) -> None:
        cur = self.get_kv("worker_lock")
        if cur and cur["owner"] == owner:
            self.set_kv("worker_lock", {"owner": owner, "expires": iso(utcnow() - timedelta(seconds=1))})

    # ---- source health ---------------------------------------------
    def get_source(self, source: str) -> dict:
        with self._lock:
            row = self.conn.execute("SELECT * FROM source_status WHERE source=?", (source,)).fetchone()
        return dict(row) if row else {"source": source, "last_ok_utc": None, "last_attempt_utc": None,
                                      "consecutive_failures": 0, "total_failures": 0, "total_checks": 0,
                                      "last_error": None, "etag": None, "last_modified": None,
                                      "content_hash": None, "next_allowed_utc": None}

    def _save_source(self, d: dict) -> None:
        cols = ["source", "last_ok_utc", "last_attempt_utc", "consecutive_failures", "total_failures", "total_checks",
                "last_error", "etag", "last_modified", "content_hash", "next_allowed_utc"]
        with self._lock:
            self.conn.execute(f"INSERT OR REPLACE INTO source_status({','.join(cols)}) VALUES({','.join('?'*len(cols))})",
                              [d.get(c) for c in cols])

    def record_check(self, source: str, ok: bool, error: str | None = None, now: datetime | None = None) -> None:
        now = now or utcnow()
        d = self.get_source(source)
        d["last_attempt_utc"] = iso(now)
        d["total_checks"] += 1
        if ok:
            d["last_ok_utc"] = iso(now)
            d["consecutive_failures"] = 0
            d["last_error"] = None
        else:
            d["consecutive_failures"] += 1
            d["total_failures"] += 1
            d["last_error"] = (error or "unknown error")[:300]
        self._save_source(d)

    def set_validators(self, source: str, etag=None, last_modified=None, content_hash=None) -> None:
        d = self.get_source(source)
        if etag is not None:
            d["etag"] = etag
        if last_modified is not None:
            d["last_modified"] = last_modified
        if content_hash is not None:
            d["content_hash"] = content_hash
        self._save_source(d)

    def set_next_allowed(self, source: str, when: datetime | None) -> None:
        d = self.get_source(source)
        d["next_allowed_utc"] = iso(when) if when else None
        self._save_source(d)

    def all_sources(self) -> list[dict]:
        with self._lock:
            return [dict(r) for r in self.conn.execute("SELECT * FROM source_status ORDER BY source")]

    # ---- posts -----------------------------------------------------
    def upsert_post(self, source, post_id, url, published_utc, text, text_hash, classification, now=None) -> str:
        """Returns 'new', 'edited' or 'same'."""
        now = now or utcnow()
        with self._lock:
            row = self.conn.execute("SELECT text_hash FROM posts WHERE source=? AND post_id=?", (source, post_id)).fetchone()
            if row is None:
                self.conn.execute("INSERT INTO posts VALUES(?,?,?,?,?,?,?,?)",
                                  (source, post_id, url, published_utc, iso(now), text, text_hash, classification))
                return "new"
            if row["text_hash"] != text_hash:
                self.conn.execute("UPDATE posts SET text=?, text_hash=?, classification=?, url=? WHERE source=? AND post_id=?",
                                  (text, text_hash, classification, url, source, post_id))
                return "edited"
            return "same"

    def text_hash_seen_elsewhere(self, text_hash: str, source: str, post_id: str) -> bool:
        with self._lock:
            row = self.conn.execute("SELECT 1 FROM posts WHERE text_hash=? AND NOT (source=? AND post_id=?) LIMIT 1",
                                    (text_hash, source, post_id)).fetchone()
        return row is not None

    def recent_posts(self, since: datetime, classifications: tuple[str, ...], trusted_sources: set[str]) -> list[dict]:
        q = ",".join("?" * len(classifications))
        with self._lock:
            rows = self.conn.execute(
                f"SELECT * FROM posts WHERE first_seen_utc>=? AND classification IN ({q}) ORDER BY first_seen_utc DESC",
                (iso(since), *classifications)).fetchall()
        return [dict(r) for r in rows if r["source"] in trusted_sources]

    # ---- notifications ---------------------------------------------
    def notification_status(self, alert_key: str, channel: str) -> dict | None:
        with self._lock:
            row = self.conn.execute("SELECT * FROM notifications WHERE alert_key=? AND channel=?", (alert_key, channel)).fetchone()
        return dict(row) if row else None

    def record_notification(self, alert_key: str, channel: str, ok: bool, error: str | None = None, now=None) -> None:
        now = now or utcnow()
        cur = self.notification_status(alert_key, channel)
        attempts = (cur["attempts"] if cur else 0) + 1
        with self._lock:
            self.conn.execute(
                "INSERT OR REPLACE INTO notifications(alert_key,channel,status,attempts,last_error,created_utc,sent_utc) VALUES(?,?,?,?,?,?,?)",
                (alert_key, channel, "sent" if ok else "failed", attempts, None if ok else (error or "")[:300],
                 cur["created_utc"] if cur else iso(now), iso(now) if ok else (cur or {}).get("sent_utc")))

    def last_alert(self) -> dict | None:
        with self._lock:
            row = self.conn.execute("SELECT * FROM notifications WHERE status='sent' ORDER BY sent_utc DESC LIMIT 1").fetchone()
        return dict(row) if row else None

    def channel_health(self) -> dict[str, dict]:
        out: dict[str, dict] = {}
        with self._lock:
            for r in self.conn.execute("SELECT channel, status, COUNT(*) n FROM notifications GROUP BY channel, status"):
                out.setdefault(r["channel"], {})[r["status"]] = r["n"]
        return out

"""Text classification (English + Arabic) and the booking-availability state machine.

Design rules
------------
* A failed request, CAPTCHA, empty page or changed HTML is NEVER evidence that tickets opened.
* Only the VOX site itself can move the state to CONFIRMED_OPEN.
* Social posts / news can at most produce SUSPECTED_OPEN (a *preliminary* alert) or ANNOUNCED.
"""
import re
import unicodedata
from dataclasses import dataclass, replace

UNKNOWN = "UNKNOWN"
NOT_LISTED = "NOT_LISTED"
COMING_SOON = "COMING_SOON"
ANNOUNCED = "ANNOUNCED"
SUSPECTED_OPEN = "SUSPECTED_OPEN"
CONFIRMED_OPEN = "CONFIRMED_OPEN"
TEMPORARILY_UNAVAILABLE = "TEMPORARILY_UNAVAILABLE"
ERROR = "ERROR"
OPEN_STATES = (SUSPECTED_OPEN, CONFIRMED_OPEN)

# ---------------------------------------------------------------- text helpers
_AR_MARKS = re.compile(r"[\u0610-\u061A\u064B-\u065F\u0670\u06D6-\u06ED\u0640]")
_AR_MAP = str.maketrans({"أ": "ا", "إ": "ا", "آ": "ا", "ى": "ي", "ة": "ه", "ؤ": "و", "ئ": "ي"})


def normalize(text: str) -> str:
    t = unicodedata.normalize("NFKC", text or "")
    t = _AR_MARKS.sub("", t).translate(_AR_MAP).lower()
    t = t.replace("’", "'").replace("‘", "'")
    return re.sub(r"\s+", " ", t).strip()


_TITLE_FULL = [
    re.compile(r"avengers?\s*[:\-–—_]?\s*doom'?s?\s*day"),
    re.compile(r"(?:افنجرز|الافنجرز|الانتقاميون)\s*[:\-–—]?\s*(?:دومزداي|دومسداي|دوومزداي|دوم\s*زداي|يوم\s*القياماه|doomsday)"),
]
_TITLE_ALONE = re.compile(r"\bdoomsday\b|دومزداي|دومسداي")
_TITLE_CONTEXT = re.compile(r"avengers|marvel|افنجرز|الانتقاميون|مارفل")


def mentions_target(text: str) -> bool:
    t = normalize(text)
    if any(p.search(t) for p in _TITLE_FULL):
        return True
    return bool(_TITLE_ALONE.search(t) and _TITLE_CONTEXT.search(t))


_OPEN = [
    r"tickets?\s+(?:are\s+)?(?:now\s+)?(?:on\s+sale|available|live)",
    r"(?:on\s+sale|available|booking|bookings)\s+(?:now|today)",
    r"book(?:ing|ings)?\s+(?:is\s+|are\s+)?(?:now\s+)?(?:open|live)",
    r"now\s+(?:booking|open\s+for\s+booking|on\s+sale)",
    r"book\s+(?:your\s+)?(?:tickets?|seats?)\s+now",
    r"(?:grab|get)\s+your\s+tickets?\s+now",
    r"الحجز\s+(?:متاح|مفتوح|بدا)",
    r"(?:بدا|بدء|فتح)\s+(?:ال)?حجز",
    r"(?:ال)?تذاكر\s+متاحه",
    r"احجز\s+(?:تذكرتك|تذاكرك|مقعدك)",
    r"متاحه?\s+(?:الان|للحجز)",
]
_FUTURE = [
    r"coming\s+soon", r"stay\s+tuned", r"get\s+ready", r"\bsoon\b", r"\btomorrow\b", r"countdown",
    r"(?:will|to)\s+(?:be\s+)?(?:available|on\s+sale|open|start|begin)",
    r"go(?:es)?\s+on\s+sale(?!\s+(?:now|today))",
    r"(?:available|on\s+sale|opens?|opening|starts?|starting|begins?|beginning)\s+(?:from|on|next|in\s+\d+|this\s+\w+day)",
    r"\bnext\s+(?:week|month|\w+day)",
    r"قريبا", r"ترقبوا", r"استعدوا", r"غدا",
    r"الاسبوع\s+(?:القادم|الجاي)", r"ابتداء\s+من",
    r"(?:هي|هت|سي|ست)(?:بدا|تاح|فتح|طرح)",
]
_ADVANCE = [r"advance\s+(?:booking|tickets?)", r"pre-?\s?sale", r"pre-?\s?booking", r"حجز\s+مسبق"]
_OPEN_RE = [re.compile(p) for p in _OPEN]
_FUTURE_RE = [re.compile(p) for p in _FUTURE]
_ADVANCE_RE = [re.compile(p) for p in _ADVANCE]


@dataclass(frozen=True)
class TextVerdict:
    kind: str            # OPEN_NOW | FUTURE | MENTION | NONE
    open_hits: tuple = ()
    future_hits: tuple = ()
    mixed: bool = False


def classify_text(text: str) -> TextVerdict:
    """Context-aware classification of an announcement."""
    if not mentions_target(text):
        return TextVerdict("NONE")
    t = normalize(text)
    open_hits = tuple(p.pattern for p in _OPEN_RE if p.search(t))
    future_hits = tuple(p.pattern for p in _FUTURE_RE if p.search(t))
    advance = any(p.search(t) for p in _ADVANCE_RE)
    if open_hits and not future_hits:
        return TextVerdict("OPEN_NOW", open_hits, future_hits)
    if future_hits:
        return TextVerdict("FUTURE", open_hits, future_hits, mixed=bool(open_hits))
    if advance:
        return TextVerdict("FUTURE", open_hits, ("advance-mention",))
    return TextVerdict("MENTION")


# ---------------------------------------------------------------- state machine
@dataclass(frozen=True)
class Evidence:
    fetch_ok: bool
    error: str | None = None
    on_whatson: bool = False        # target card with a "Showtimes" link on /movies/whatson
    in_selector: bool = False       # target listed in the site's bookable-movie selector
    in_coming_soon: bool = False
    page_verified: bool = False     # movie page really is Avengers: Doomsday
    booking_url: str | None = None
    social: str | None = None       # OPEN_NOW | FUTURE | None  (from trusted official sources only)
    social_url: str | None = None
    social_source: str | None = None


@dataclass(frozen=True)
class BookingState:
    state: str = UNKNOWN
    opening_id: int = 0
    miss_count: int = 0
    evidence_summary: str = ""
    booking_url: str | None = None
    changed_at: str | None = None


@dataclass(frozen=True)
class Alert:
    kind: str       # critical | preliminary | degraded | recovered | info | test
    key: str
    title: str
    body: str
    url: str | None = None


def site_verdict(ev: Evidence) -> str | None:
    """'CONFIRMED', 'SUSPECTED', 'CLOSED' or None when the site could not be read."""
    if not ev.fetch_ok:
        return None
    if ev.on_whatson and ev.in_selector and ev.page_verified:
        return "CONFIRMED"
    if ev.on_whatson or ev.in_selector:
        return "SUSPECTED"
    return "CLOSED"


def _why(ev: Evidence, verdict: str | None) -> str:
    parts = []
    if ev.on_whatson:
        parts.append("listed on VOX What's On with a Showtimes link")
    if ev.in_selector:
        parts.append("present in VOX bookable-movie selector")
    if ev.page_verified:
        parts.append("movie page verified as Avengers: Doomsday")
    if ev.social == "OPEN_NOW":
        parts.append(f"official post says booking is open ({ev.social_source})")
    return "; ".join(parts) or (ev.error or "no evidence")


def advance(prev: BookingState, ev: Evidence, miss_threshold: int = 3, realert_on_reopen: bool = True,
            now_iso: str | None = None) -> tuple[BookingState, Alert | None]:
    """Pure function: previous state + new evidence -> new state (+ optional alert)."""
    verdict = site_verdict(ev)
    new_state = prev.state
    miss = prev.miss_count
    url = ev.booking_url or prev.booking_url

    if verdict == "CONFIRMED":
        new_state, miss = CONFIRMED_OPEN, 0
    elif verdict == "SUSPECTED":
        new_state, miss = (prev.state if prev.state == CONFIRMED_OPEN else SUSPECTED_OPEN), 0
    elif ev.social == "OPEN_NOW":
        # Official social says "open" but the site cannot confirm (closed or unreadable): preliminary only.
        new_state = prev.state if prev.state == CONFIRMED_OPEN else SUSPECTED_OPEN
        miss = 0
    elif verdict is None:
        # Unreadable site: never flip away from an open state, never claim open.
        if prev.state in OPEN_STATES:
            new_state = prev.state
        elif ev.social == "FUTURE":
            new_state = ANNOUNCED
        else:
            new_state = ERROR if prev.state in (UNKNOWN, ERROR) else prev.state
    else:  # site readable, target not bookable
        if prev.state in OPEN_STATES and miss + 1 < miss_threshold:
            new_state, miss = prev.state, miss + 1
        elif prev.state in OPEN_STATES:
            new_state, miss = TEMPORARILY_UNAVAILABLE, 0
        elif prev.state == TEMPORARILY_UNAVAILABLE:
            new_state = TEMPORARILY_UNAVAILABLE
        elif ev.social == "FUTURE":
            new_state = ANNOUNCED
        elif ev.in_coming_soon:
            new_state = COMING_SOON
        else:
            new_state = NOT_LISTED

    opening_id = prev.opening_id
    entering_open = new_state in OPEN_STATES and prev.state not in OPEN_STATES
    if entering_open:
        reopened = prev.opening_id > 0
        opening_id = prev.opening_id + 1 if (not reopened or realert_on_reopen) else prev.opening_id

    alert = None
    if new_state == CONFIRMED_OPEN and prev.state != CONFIRMED_OPEN:
        alert = Alert("critical", f"critical:{opening_id}",
                      "AVENGERS: DOOMSDAY BOOKING IS OPEN at VOX Egypt (CONFIRMED)",
                      f"Confirmed: {_why(ev, verdict)}.", url)
    elif new_state == SUSPECTED_OPEN and prev.state not in OPEN_STATES:
        alert = Alert("preliminary", f"preliminary:{opening_id}",
                      "Avengers: Doomsday booking MAY have opened at VOX Egypt (preliminary)",
                      f"Not yet confirmed by the booking pages: {_why(ev, verdict)}.", url or ev.social_url)

    summary = _why(ev, verdict) if new_state != prev.state or not prev.evidence_summary else prev.evidence_summary
    state = replace(prev, state=new_state, opening_id=opening_id, miss_count=miss, evidence_summary=summary,
                    booking_url=url, changed_at=now_iso if new_state != prev.state else prev.changed_at)
    return state, alert

"""Email via SMTP (Gmail App Password works on the free tier)."""
import os
import smtplib
import ssl
from email.message import EmailMessage


def configured() -> bool:
    return all(os.environ.get(k) for k in ("SMTP_HOST", "SMTP_USER", "SMTP_PASSWORD", "ALERT_EMAIL_TO"))


def send(subject: str, body: str) -> None:
    host, port = os.environ["SMTP_HOST"], int(os.environ.get("SMTP_PORT", "465"))
    user, pwd, to = os.environ["SMTP_USER"], os.environ["SMTP_PASSWORD"], os.environ["ALERT_EMAIL_TO"]
    msg = EmailMessage()
    msg["Subject"], msg["From"], msg["To"] = subject, os.environ.get("ALERT_EMAIL_FROM", user), to
    msg.set_content(body)
    ctx = ssl.create_default_context()
    if port == 465:
        with smtplib.SMTP_SSL(host, port, context=ctx, timeout=30) as s:
            s.login(user, pwd)
            s.send_message(msg)
    else:
        with smtplib.SMTP(host, port, timeout=30) as s:
            s.starttls(context=ctx)
            s.login(user, pwd)
            s.send_message(msg)

"""Beginner-friendly status report + tiny /health HTTP endpoint (for hosts that need one)."""
import json
import threading
from datetime import datetime, timedelta, timezone
from http.server import BaseHTTPRequestHandler, HTTPServer
from zoneinfo import ZoneInfo

from .database import Database, parse_iso, utcnow
from .notifications import channel_registry

CAIRO = ZoneInfo("Africa/Cairo")


def _fmt(ts: str | None) -> str:
    dt = parse_iso(ts)
    return dt.astimezone(CAIRO).strftime("%Y-%m-%d %H:%M:%S") + " Cairo" if dt else "never"


def degraded_sources(db: Database, cfg: dict, now: datetime | None = None) -> list[str]:
    now = now or utcnow()
    limit = timedelta(minutes=cfg.get("degraded_after_minutes", 45))
    bad = []
    for src in cfg.get("critical_sources", ["vox_whatson"]):
        last = parse_iso(db.get_source(src)["last_ok_utc"])
        first = parse_iso(db.get_kv("monitor_first_run"))
        ref = last or first
        if ref is None or now - ref > limit:
            bad.append(src)
    return bad


def build_status(db: Database, cfg: dict) -> str:
    now = utcnow()
    st = db.get_kv("booking_state", {})
    bad = degraded_sources(db, cfg, now)
    hb = parse_iso(db.get_kv("heartbeat"))
    lines = ["=" * 60, "VOX AVENGERS: DOOMSDAY MONITOR - STATUS", "=" * 60,
             f"Overall monitor : {'DEGRADED - ' + ', '.join(bad) + ' not checked recently' if bad else 'HEALTHY'}",
             f"Booking state   : {st.get('state', 'UNKNOWN')}   (why: {st.get('evidence_summary') or '-'})",
             f"Last valid link : {st.get('booking_url') or 'none yet'}",
             f"Last heartbeat  : {_fmt(db.get_kv('heartbeat'))}" + (f"  ({int((now - hb).total_seconds() // 60)} min ago)" if hb else ""),
             f"Polling mode    : {db.get_kv('polling_mode', '-')} (every ~{db.get_kv('polling_seconds', '-')} s)",
             "", "Sources:"]
    for s in db.all_sources():
        lines.append(f"  - {s['source']:<22} last OK: {_fmt(s['last_ok_utc']):<28} fails in a row: {s['consecutive_failures']}"
                     f"  total fails: {s['total_failures']}" + (f"  last error: {s['last_error']}" if s["last_error"] else ""))
    lines += ["", "Notification channels (configured?):"]
    health = db.channel_health()
    for name, ok, _ in channel_registry(cfg):
        h = health.get(name, {})
        lines.append(f"  - {name:<9} {'configured' if ok else 'not configured':<15} sent={h.get('sent', 0)} failed={h.get('failed', 0)}")
    la = db.last_alert()
    lines += ["", f"Last alert sent : {_fmt(la['sent_utc']) + ' (' + la['alert_key'] + ' via ' + la['channel'] + ')' if la else 'none yet'}",
              f"Known cinemas   : {', '.join(db.get_kv('cinemas', [])) or 'not read yet'}", "=" * 60]
    return "\n".join(lines)


def serve_health(db_path: str, cfg: dict, port: int) -> HTTPServer:
    from .database import Database as DB

    class H(BaseHTTPRequestHandler):
        def do_GET(self):  # noqa: N802
            db = DB(db_path)
            bad = degraded_sources(db, cfg)
            body = json.dumps({"ok": not bad, "degraded": bad, "state": db.get_kv("booking_state", {}).get("state"),
                               "heartbeat": db.get_kv("heartbeat")}).encode()
            db.close()
            self.send_response(200 if not bad else 503)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *a):  # silence
            pass

    srv = HTTPServer(("0.0.0.0", port), H)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv

"""Polite HTTP client: timeouts, conditional requests, robots.txt, backoff, block detection."""
import hashlib
import logging
import random
import time
import urllib.robotparser
from dataclasses import dataclass
from datetime import timedelta
from urllib.parse import urlparse

import requests

from .database import Database, utcnow

log = logging.getLogger(__name__)
BLOCK_MARKERS = ("captcha", "cf-challenge", "just a moment", "access denied", "are you a robot", "unusual traffic")


@dataclass
class FetchResult:
    ok: bool
    status: int | None = None
    text: str = ""
    not_modified: bool = False
    blocked: bool = False
    error: str | None = None
    skipped: bool = False


def backoff_seconds(failures: int, base: int = 30, cap: int = 3600, rng: random.Random | None = None) -> float:
    """Exponential backoff with full jitter."""
    rng = rng or random
    return rng.uniform(base / 2, min(cap, base * (2 ** max(0, failures - 1))))


class RateLimiter:
    """Hard cap on requests per rolling hour (safe-fallback protection)."""
    def __init__(self, max_per_hour: int):
        self.max = max_per_hour
        self.stamps: list[float] = []

    def allow(self, now: float | None = None) -> bool:
        now = now or time.time()
        self.stamps = [s for s in self.stamps if now - s < 3600]
        if len(self.stamps) >= self.max:
            return False
        self.stamps.append(now)
        return True


class PoliteClient:
    def __init__(self, cfg: dict, db: Database, session: requests.Session | None = None):
        self.cfg = cfg
        self.db = db
        self.session = session or requests.Session()
        self.session.headers.update({"User-Agent": cfg.get("user_agent", "vox-avengers-monitor/1.0 (personal ticket alert)"),
                                     "Accept-Language": "en,ar;q=0.8"})
        self.timeout = cfg.get("request_timeout_seconds", 15)
        self.limiter = RateLimiter(cfg.get("max_requests_per_hour", 150))
        self._robots: dict[str, urllib.robotparser.RobotFileParser | None] = {}

    def robots_allows(self, url: str) -> bool:
        if not self.cfg.get("respect_robots", True):
            return True
        p = urlparse(url)
        origin = f"{p.scheme}://{p.netloc}"
        if origin not in self._robots:
            rp = urllib.robotparser.RobotFileParser()
            try:
                r = self.session.get(origin + "/robots.txt", timeout=self.timeout)
                if r.status_code == 200:
                    rp.parse(r.text.splitlines())
                    self._robots[origin] = rp
                else:
                    self._robots[origin] = None  # no usable robots.txt -> nothing disallowed
            except requests.RequestException:
                self._robots[origin] = None
        rp = self._robots[origin]
        return True if rp is None else rp.can_fetch(self.session.headers["User-Agent"], url)

    def get(self, source: str, url: str, conditional: bool = True) -> FetchResult:
        now = utcnow()
        st = self.db.get_source(source)
        nxt = st.get("next_allowed_utc")
        if nxt and nxt > now.strftime("%Y-%m-%dT%H:%M:%SZ"):
            return FetchResult(False, skipped=True, error=f"backing off until {nxt}")
        if not self.robots_allows(url):
            self.db.record_check(source, False, "blocked by robots.txt")
            return FetchResult(False, blocked=True, error="robots.txt disallows this URL")
        if not self.limiter.allow():
            return FetchResult(False, skipped=True, error="local request-rate cap reached")
        headers = {}
        if conditional and st.get("etag"):
            headers["If-None-Match"] = st["etag"]
        if conditional and st.get("last_modified"):
            headers["If-Modified-Since"] = st["last_modified"]
        try:
            r = self.session.get(url, headers=headers, timeout=self.timeout)
        except requests.RequestException as exc:
            return self._fail(source, f"network error: {type(exc).__name__}")
        if r.status_code == 304:
            self.db.record_check(source, True)
            self.db.set_next_allowed(source, None)
            return FetchResult(True, 304, not_modified=True)
        if r.status_code in (403, 429, 503) or any(m in r.text[:5000].lower() for m in BLOCK_MARKERS):
            extra = float(r.headers.get("Retry-After", 0)) if r.headers.get("Retry-After", "").isdigit() else 0
            res = self._fail(source, f"blocked or rate-limited (HTTP {r.status_code})", extra_wait=extra)
            res.blocked, res.status = True, r.status_code
            return res
        if r.status_code >= 400:
            res = self._fail(source, f"HTTP {r.status_code}")
            res.status = r.status_code
            return res
        if not r.text.strip():
            return self._fail(source, "empty response")
        self.db.record_check(source, True)
        self.db.set_next_allowed(source, None)
        self.db.set_validators(source, etag=r.headers.get("ETag"), last_modified=r.headers.get("Last-Modified"),
                               content_hash=hashlib.sha256(r.content).hexdigest())
        return FetchResult(True, r.status_code, r.text)

    def _fail(self, source: str, msg: str, extra_wait: float = 0) -> FetchResult:
        self.db.record_check(source, False, msg)
        n = self.db.get_source(source)["consecutive_failures"]
        wait = max(extra_wait, backoff_seconds(n, self.cfg.get("backoff_base_seconds", 30), self.cfg.get("backoff_cap_seconds", 3600)))
        self.db.set_next_allowed(source, utcnow() + timedelta(seconds=wait))
        log.warning("source=%s failure #%d: %s (backing off %.0fs)", source, n, msg, wait)
        return FetchResult(False, error=msg)

"""Windows companion core: listens to the free ntfy.sh topic and plays a loud sound + toast on critical alerts."""
