# Copy this file to ".env" for LOCAL runs only. NEVER commit ".env".
# On GitHub, put these values in Settings > Secrets and variables > Actions > Secrets instead.

# --- Email (Gmail SMTP with an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
ALERT_EMAIL_TO=your-address@gmail.com

# --- Push to phone + laptop via ntfy.sh (free). Pick a long random topic; it acts like a password ---
NTFY_TOPIC=replace-with-a-long-random-string
NTFY_SERVER=https://ntfy.sh

# --- Optional: Telegram bot (free, instant phone alert) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: WhatsApp Cloud API (NOT free since 1 Oct 2026 -- leave empty unless you approve it) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_TEMPLATE=

# --- Optional: dead-man's-switch ping URL (e.g. healthchecks.io) ---
HEALTHCHECK_PING_URL=

# --- Runtime switches ---
DRY_RUN=0
